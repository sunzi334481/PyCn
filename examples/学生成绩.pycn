# 学生成绩统计：演示列表、字典、排序、分组与聚合
打印("===== 成绩统计 =====")

成绩记录 = [
    {"名字": "张三", "科目": "数学", "分数": 88},
    {"名字": "李四", "科目": "数学", "分数": 57},
    {"名字": "王五", "科目": "数学", "分数": 92},
    {"名字": "赵六", "科目": "数学", "分数": 73},
    {"名字": "张三", "科目": "语文", "分数": 95},
    {"名字": "李四", "科目": "语文", "分数": 81},
    {"名字": "王五", "科目": "语文", "分数": 68},
    {"名字": "赵六", "科目": "语文", "分数": 90},
]

# 按分数从高到低排序
排序后 = 排序(成绩记录, 键=匿名 记录: 记录["分数"], 倒序=真)
打印("分数排名：")
对于 名次, 记录 在 枚举(排序后, 1):
    打印(格"  第{名次}名 {记录['名字']} {记录['科目']} {记录['分数']}分")

# 按学生分组统计平均分
学生分数 = {}
对于 记录 在 成绩记录:
    名字 = 记录["名字"]
    如果 名字 不在 学生分数:
        学生分数[名字] = []
    学生分数[名字].追加(记录["分数"])

打印("学生平均分：")
对于 名字, 分数们 在 学生分数.项():
    平均 = 求和(分数们) / 长度(分数们)
    状态 = "及格" 如果 平均 >= 60 否则 "不及格"
    打印(格"  {名字}：{平均:.1f} 分（{状态}）")

# 总体指标
所有分数 = [记录["分数"] 对于 记录 在 成绩记录]
打印(格"全班最高分 {最大值(所有分数)}，最低分 {最小值(所有分数)}")
及格率 = 长度([x 对于 x 在 所有分数 如果 x >= 60]) / 长度(所有分数) * 100
打印(格"及格率：{及格率:.0f}%")
