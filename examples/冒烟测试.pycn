# PyCn 冒烟测试：覆盖主要语法
# 1. 变量与内置函数
分数列表 = [88, 76, 92, 65, 100]
打印("人数：", 长度(分数列表))
打印("最高分：", 最大值(分数列表), " 最低分：", 最小值(分数列表))
打印("平均分：", 求和(分数列表) / 长度(分数列表))

# 2. 控制流
及格 = 0
对于 分数 在 分数列表:
    如果 分数 >= 60:
        及格 += 1
    否则:
        打印("不及格分数：", 分数)
打印("及格人数：", 及格)

# 3. 定义函数
定义 阶乘(数):
    如果 数 <= 1:
        返回 1
    返回 数 * 阶乘(数 - 1)
打印("5的阶乘：", 阶乘(5))

# 4. 类
类 学生:
    定义 __初始化__(自己, 名字, 分数):
        自己.名字 = 名字
        自己.分数 = 分数
    定义 是否及格(自己):
        返回 自己.分数 >= 60
    定义 __字符串__(自己):
        返回 格"学生({自己.名字}, {自己.分数})"

小明 = 学生("小明", 92)
打印(小明, "及格吗？", 小明.是否及格())

# 5. 标准库
导入 数学
打印("根号2：", 数学.平方根(2))
打印("圆周率：", 数学.圆周率)

# 6. 异常
尝试:
    结果 = 1 / 0
捕获 零除错误 作为 错误:
    打印("捕获到异常：", 错误)
最终:
    打印("最终块执行")

# 7. 主程序判断
如果 __名字__ == "__主__":
    打印("冒烟测试全部通过")
