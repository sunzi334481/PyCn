# 面向对象演示：类、继承、多态、封装（property）、魔术方法
打印("===== 面向对象演示 =====")
导入 数学


类 形状:
    """所有形状的基类。"""

    定义 面积(自己):
        抛出 未实现错误("子类必须实现面积方法")

    定义 介绍(自己):
        返回 格"{自己}，面积 = {自己.面积():.2f}"


类 矩形(形状):
    定义 __初始化__(自己, 宽, 高):
        自己._宽 = 宽
        自己._高 = 高

    @属性
    def 宽(自己):
        返回 自己._宽

    @属性
    def 高(自己):
        返回 自己._高

    定义 面积(自己):
        返回 自己._宽 * 自己._高

    定义 __字符串__(自己):
        返回 格"矩形(宽={自己._宽}, 高={自己._高})"

    定义 __相等__(自己, 其他):
        如果 是实例(其他, 矩形):
            返回 自己._宽 == 其他._宽 且 自己._高 == 其他._高
        返回 假


类 圆形(形状):
    定义 __初始化__(自己, 半径):
        自己.半径 = 半径

    定义 面积(自己):
        返回 数学.圆周率 * 自己.半径 ** 2

    定义 __字符串__(自己):
        返回 格"圆形(半径={自己.半径})"


形状们 = [矩形(3, 4), 圆形(5), 矩形(6, 2)]
对于 形状 在 形状们:
    # 多态：不同形状调用同一接口
    打印(" ", 形状.介绍())

# property 读取
矩形一 = 矩形(3, 4)
打印(格"矩形一的宽（只读属性）= {矩形一.宽}")

# 相等比较（__相等__）
打印("两个 3x4 矩形相等吗？", 矩形一 == 矩形(3, 4))
打印("矩形与圆形相等吗？", 矩形一 == 圆形(3))


# 类变量与类方法演示
类 计数器:
    总数 = 0

    定义 __初始化__(自己):
        计数器.总数 += 1

    @类方法
    def 已创建(本类):
        返回 本类.总数


计数器()
计数器()
打印("已创建对象数：", 计数器.已创建())
