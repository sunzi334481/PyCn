# 标准库演示：数学 / 随机 / 日期时间 / 序列化(JSON) / 正则 / 操作系统
打印("===== 标准库演示 =====")

# ---- math ----
导入 数学
打印("根号 16 =", 数学.平方根(16))
打印("3 的阶乘 =", 数学.阶乘(3))
打印("向上取整 2.3 =", 数学.向上取整(2.3))
打印("sin(π/2) =", 数学.正弦(数学.圆周率 / 2))

# ---- random ----
导入 随机
随机.设置种子(42)
打印("随机整数 [1, 100]：", 随机.随机整数(1, 100))
打印("从列表选择：", 随机.选择(["苹果", "香蕉", "橘子"]))
牌 = ["A", "B", "C", "D"]
随机.打乱(牌)
打印("洗牌后：", 牌)

# ---- datetime ----
从 日期时间 导入 日期时间类
现在 = 日期时间类.现在()
打印("当前日期时间：", 现在.格式化时间("%Y-%m-%d %H:%M:%S"))
打印("今年是：", 现在.年)

# ---- json ----
导入 序列化
数据 = {"名字": "测试", "分数": [90, 80, 70], "通过": 真}
文本 = 序列化.转文本(数据, 确保ASCII=假, 缩进=2)
打印("JSON 文本：")
打印(文本)
还原 = 序列化.解析文本(文本)
打印("还原后名字：", 还原["名字"])

# ---- re ----
导入 正则
文本串 = "联系电话：13800138000，备用：010-12345678"
匹配 = 正则.搜索(r"1[3-9]\d{9}", 文本串)
如果 匹配:
    打印("找到手机号：", 匹配.分组())
打印("替换数字：", 正则.正则替换(r"\d+", "#", 文本串))

# ---- os ----
导入 操作系统
打印("当前工作目录：", 操作系统.当前目录())
打印("目录内容：", 操作系统.列出目录("."))
打印("本文件存在吗？", 操作系统.路径.存在(__文件__))

打印("===== 标准库演示完成 =====")
