# 异常处理演示：try/except/finally、异常类型、自定义异常
打印("===== 异常处理演示 =====")


# 自定义异常
类 分数越界错误(异常):
    定义 __初始化__(自己, 分数, 消息="分数必须在 0~100 之间"):
        超类().__init__(消息)
        自己.分数 = 分数


定义 检查分数(分数):
    如果 非 类型(分数) 在 (整数, 浮点):
        抛出 类型错误("分数必须是数字")
    如果 分数 < 0 或 分数 > 100:
        抛出 分数越界错误(分数)
    返回 格"{分数} 分合法"


对于 候选 在 [95, -10, "优秀", 120, 88]:
    尝试:
        结果 = 检查分数(候选)
        打印(" ", 结果)
    捕获 分数越界错误 作为 e:
        打印(" ", 格"越界：{e}（给出的分数={e.分数}）")
    捕获 类型错误 作为 e:
        打印(" ", 格"类型错误：{e}")
    最终:
        打印("    -- 检查完毕 --")


# else 子句：没有异常时执行
尝试:
    值 = 整数("123")
捕获 值错误:
    打印("转换失败")
否则:
    打印(格"转换成功，值 = {值}")

打印("===== 异常处理演示完成 =====")
