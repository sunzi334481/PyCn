      "\t${4:跳过}",
      "最终:",
      "\t${5:跳过}"
    ],
    "description": "try/except/finally"
  },
  "伴随": {
    "prefix": "伴随",
    "body": ["伴随 ${1:表达式} 作为 ${2:名字}:", "\t${3:跳过}"],
    "description": "with 语句"
  },
  "匹配": {
    "prefix": "匹配",
    "body": [
      "匹配 ${1:目标}:",
      "\t情形 ${2:值}:",
      "\t\t${3:跳过}",
      "\t情形 _:",
      "\t\t${4:跳过}"
    ],
    "description": "match/case 语句"
  },
  "主程序模板": {
    "prefix": "主程序",
    "body": [
      "定义 主():",
      "\t${1:跳过}",
      "",
      "如果 __名字__ == \"__主__\":",
      "\t主()"
    ],
    "description": "主程序入口模板"
  },
  "异步函数": {
    "prefix": "异步",
    "body": ["异步 定义 ${1:函数名}(${2:参数}):", "\t${3:跳过}"],
    "description": "async def"
  }
