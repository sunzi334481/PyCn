{
  "定义函数": {
    "prefix": "定义",
    "body": ["定义 ${1:函数名}(${2:参数}):", "\t${3:跳过}"],
    "description": "定义函数"
  },
  "定义类": {
    "prefix": "类",
    "body": ["类 ${1:类名}:", "\t定义 __初始化__(自己${2:, 参数}):", "\t\t${3:跳过}", ""],
    "description": "定义类"
  },
  "如果": {
    "prefix": "如果",
    "body": ["如果 ${1:条件}:", "\t${2:跳过}"],
    "description": "if 语句"
  },
  "如果否则": {
    "prefix": "否则",
    "body": ["如果 ${1:条件}:", "\t${2:跳过}", "否则:", "\t${3:跳过}"],
    "description": "if/else 语句"
  },
  "否则若": {
    "prefix": "否则若",
    "body": ["否则若 ${1:条件}:", "\t${2:跳过}"],
    "description": "elif 语句"
  },
  "对于循环": {
    "prefix": "对于",
    "body": ["对于 ${1:元素} 在 ${2:可迭代对象}:", "\t${3:跳过}"],
    "description": "for 循环"
  },
  "当循环": {
    "prefix": "当",
    "body": ["当 ${1:条件}:", "\t${2:跳过}"],
    "description": "while 循环"
  },
  "尝试捕获": {
    "prefix": "尝试",
    "body": [
      "尝试:",
      "\t${1:跳过}",
